<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/fxml/1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.garre.appreservasjavafx.HelloController">
    <children>
        <Label layoutX="30.0" layoutY="20.0" text="Gestión de Reservas">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <!-- TABLA PRINCIPAL -->
        <TableView fx:id="tablaReservas" layoutX="30.0" layoutY="60.0" prefHeight="300.0" prefWidth="840.0">
            <columns>
                <TableColumn fx:id="colIdLocal" prefWidth="100.0" text="ID Local" />
                <TableColumn fx:id="colFecha" prefWidth="150.0" text="Fecha" />
                <TableColumn fx:id="colMotivo" prefWidth="440.0" text="Motivo" />
                <TableColumn fx:id="colPlazas" prefWidth="130.0" text="Plazas" />
            </columns>
        </TableView>

        <!-- FORMULARIO DE INSERCIÓN RÁPIDA -->
        <VBox layoutX="30.0" layoutY="380.0" prefWidth="840.0" spacing="10.0" style="-fx-background-color: #f4f4f4; -fx-padding: 15; -fx-border-color: #cccccc;">
            <children>
                <Label text="Nueva Reserva / Edición">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Fecha" />
                                <DatePicker fx:id="dpFecha" prefWidth="150.0" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Motivo" />
                                <TextField fx:id="txtMotivo" promptText="Ej: Reunión proyecto" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Nº Plazas" />
                                <TextField fx:id="txtPlazas" prefWidth="80.0" promptText="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onGuardarClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Guardar Reserva" />
                        <Button mnemonicParsing="false" onAction="#onBorrarClick" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Borrar Seleccionada" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>